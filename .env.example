# Copy to .env.local and fill in. Works with any OpenAI-compatible provider.
# Without a key the app still runs in "offline mode" (rule-based extraction, built-in question banks).
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# (GROQ_API_KEY / GROQ_MODEL are also still supported)
